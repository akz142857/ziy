---
import '../styles/global.css';
import WanderingWalker from '../components/WanderingWalker.astro';
import { books, profile, projects } from '../data/site';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const favicon = `${base}favicon.svg`;
const canonical = new URL(import.meta.env.BASE_URL, Astro.site);
const ogImage = new URL(`${base}og.png`, Astro.site);
const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f1eee5" />
    <meta
      name="description"
      content="Ziy 的个人网站，收录开源项目、学习记录和电子书。"
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="ZiyOne" />
    <meta
      property="og:description"
      content="Ziy 的项目、学习记录和电子书。"
    />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <title>ZiyOne｜Ziy 的个人网站</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={favicon} />
  </head>
  <body>
    <a class="skip-link" href="#content">跳到主要内容</a>

    <header class="site-header">
      <div class="shell header-inner">
        <nav aria-label="主导航">
          <a href="#works">Works</a>
          <a href="#books">Books</a>
          <a href="#about">About</a>
        </nav>
      </div>
    </header>

    <main id="content">
      <section id="top" class="hero shell" aria-labelledby="hero-title">
        <div class="hero-meta" aria-hidden="true">
          <span>ZIYONE / PERSONAL SITE</span>
        </div>
        <WanderingWalker />
        <div class="hero-copy">
          <h1 id="hero-title">我是Ziy</h1>
          <div class="hero-actions">
            <a class="text-link" href="#works">查看项目 <span>↓</span></a>
            <a class="text-link muted" href={profile.github} target="_blank" rel="noreferrer">
              GitHub <span>↗</span>
            </a>
          </div>
        </div>
        <div class="seal" aria-label="ZiyOne">
          <span>Z</span>
          <small>ZIY<br />ONE</small>
        </div>
        <p class="hero-index" aria-hidden="true">01 <span>/</span> 03</p>
      </section>

      <section id="works" class="section shell" aria-labelledby="works-title">
        <header class="section-heading">
          <div>
            <p class="section-number">01</p>
            <h2 id="works-title">Projects / 项目</h2>
          </div>
          <p>正在做和以前做过的一些项目。</p>
        </header>

        <div class="project-list">
          {
            projects.map((project) => (
              <a
                class="project-row"
                href={project.href}
                target="_blank"
                rel="noreferrer"
                aria-label={`${project.title}，${project.category}`}
              >
                <span class="project-number">{project.number}</span>
                <div class="project-main">
                  <div class="project-title-line">
                    <h3>{project.title}</h3>
                    <span class:list={['status', project.status.toLowerCase()]}>
                      {project.status}
                    </span>
                  </div>
                  <p>{project.description}</p>
                  <ul class="tag-list" aria-label="技术标签">
                    {project.tags.map((tag) => <li>{tag}</li>)}
                  </ul>
                </div>
                <div class="project-meta">
                  <span>{project.category}</span>
                  <time>{project.year}</time>
                </div>
                <span class="arrow" aria-hidden="true">↗</span>
              </a>
            ))
          }
        </div>
      </section>

      <section id="books" class="section shell" aria-labelledby="books-title">
        <header class="section-heading">
          <div>
            <p class="section-number">02</p>
            <h2 id="books-title">Books / 电子书</h2>
          </div>
          <p>正在写或已经整理完成的书与文档。</p>
        </header>

        <div class="bookshelf">
          {
            books.map((book) => (
              <article class="book-item">
                <div class:list={['book-cover', `tone-${book.tone}`]}>
                  <span class="book-code">{book.number}</span>
                  <div>
                    <p>{book.kind}</p>
                    <h3>{book.title}</h3>
                  </div>
                  <span class="book-year">ZIYONE / {book.year}</span>
                </div>
                <div class="book-info">
                  <p class="book-kind">{book.kind}</p>
                  <h3>{book.title}</h3>
                  <p>{book.subtitle}</p>
                  {
                    book.href ? (
                      <a
                        href={book.external === false ? `${base}${book.href}` : book.href}
                        target={book.external === false ? undefined : '_blank'}
                        rel={book.external === false ? undefined : 'noreferrer'}
                      >
                        {book.status} <span>↗</span>
                      </a>
                    ) : (
                      <span class="book-status">{book.status}</span>
                    )
                  }
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section id="about" class="about-section" aria-labelledby="about-title">
        <div class="shell about-grid">
          <div class="about-index">
            <p class="section-number">03</p>
            <h2 id="about-title" class="kicker">About / 关于</h2>
          </div>
          <div class="about-note">
            <p>
              <span>一名艺术软件工程师</span>
              <span>和理想主义者。</span>
            </p>
            <div class="about-links">
              <a href={profile.github} target="_blank" rel="noreferrer">
                <span>GitHub</span><span aria-hidden="true">↗</span>
              </a>
              <a href={`mailto:${profile.email}`}>
                <span>Email</span><span aria-hidden="true">↗</span>
              </a>
              <a href="https://claycosmos.ai" target="_blank" rel="noreferrer">
                <span>ClayCosmos</span><span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="shell footer-inner">
        <p>© {currentYear} ZiyOne</p>
        <p>Built with Astro.</p>
        <a href="#top">回到顶部 ↑</a>
      </div>
    </footer>
  </body>
</html>
