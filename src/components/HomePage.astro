---
import '../styles/global.css';
import WanderingWalker from './WanderingWalker.astro';
import {
  getBooks,
  getProjects,
  homeCopy,
  localeInfo,
  profile,
  supportedLocales,
  type Locale,
} from '../data/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = homeCopy[locale];
const projects = getProjects(locale);
const books = getBooks(locale);
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const localePaths = Object.fromEntries(
  supportedLocales.map((item) => [item, `${base}${localeInfo[item].path}`]),
) as Record<Locale, string>;
const currentPath = localePaths[locale];
const favicon = `${base}favicon.svg`;
const canonical = new URL(currentPath, Astro.site);
const ogImage = new URL(`${base}og.png`, Astro.site);
const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang={localeInfo[locale].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f1eee5" />
    <meta name="description" content={copy.meta.description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="ZiyOne" />
    <meta property="og:description" content={copy.meta.ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={localeInfo[locale].ogLocale} />
    {
      supportedLocales
        .filter((item) => item !== locale)
        .map((item) => (
          <meta property="og:locale:alternate" content={localeInfo[item].ogLocale} />
        ))
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <title>{copy.meta.title}</title>
    <link rel="canonical" href={canonical} />
    {
      supportedLocales.map((item) => (
        <link
          rel="alternate"
          hreflang={localeInfo[item].htmlLang}
          href={new URL(localePaths[item], Astro.site)}
        />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(localePaths.zh, Astro.site)} />
    <link rel="icon" href={favicon} />
    {
      locale === 'zh' && (
        <script is:inline define:vars={{ localePaths }}>
          (() => {
            try {
              const key = 'ziyone-locale';
              const saved = localStorage.getItem(key);
              const languages = navigator.languages?.length
                ? navigator.languages
                : [navigator.language];
              const detected = languages
                .map((language) => language.toLowerCase())
                .map((language) => language.startsWith('ja')
                  ? 'ja'
                  : language.startsWith('en')
                    ? 'en'
                    : language.startsWith('zh')
                      ? 'zh'
                      : null)
                .find(Boolean) ?? 'zh';
              const preferred = saved === 'zh' || saved === 'en' || saved === 'ja'
                ? saved
                : detected;
              if (preferred !== 'zh') {
                location.replace(`${localePaths[preferred]}${location.hash}`);
              }
            } catch {
              // Keep the Chinese default when browser preferences are unavailable.
            }
          })();
        </script>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#content">{copy.accessibility.skip}</a>

    <header class="site-header" data-site-header>
      <div class="shell header-inner">
        <nav class="main-nav" aria-label={copy.accessibility.mainNavigation}>
          <a href="#works">{copy.nav.works}</a>
          <a href="#books">{copy.nav.books}</a>
          <a href="#about">{copy.nav.about}</a>
        </nav>
        <div class="language-switcher" role="navigation" aria-label={copy.accessibility.languageNavigation}>
          {
            supportedLocales.map((item) => (
              <a
                href={localePaths[item]}
                lang={localeInfo[item].htmlLang}
                hreflang={localeInfo[item].htmlLang}
                aria-label={localeInfo[item].label}
                aria-current={item === locale ? 'page' : undefined}
                data-locale-link={item}
                title={localeInfo[item].label}
              >
                <span class="language-long">{localeInfo[item].label}</span>
                <span class="language-short" aria-hidden="true">{localeInfo[item].shortLabel}</span>
              </a>
            ))
          }
        </div>
      </div>
    </header>

    <main id="content">
      <section id="top" class="hero shell" aria-labelledby="hero-title">
        <WanderingWalker />
        <div class="hero-copy">
          <div class="hero-title-line">
            <h1 id="hero-title">{copy.hero.title}</h1>
            <div class="seal" data-pet-home aria-label={copy.accessibility.seal}>
              <span>Z</span>
              <small>ZIY<br />ONE</small>
            </div>
          </div>
          <div class="hero-actions">
            <a class="text-link" href="#works">{copy.hero.projectsLink} <span>↓</span></a>
            <a class="text-link muted" href={profile.github} target="_blank" rel="noreferrer">
              GitHub <span>↗</span>
              <span class="visually-hidden">{copy.accessibility.newTab}</span>
            </a>
          </div>
        </div>
      </section>

      <section id="works" class="section shell" aria-labelledby="works-title">
        <header class="section-heading">
          <div>
            <p class="section-number">01 / PROJECTS</p>
            <h2 id="works-title">{copy.works.title}</h2>
          </div>
          <p>{copy.works.intro}</p>
        </header>

        <div class="project-list">
          {
            projects.map((project) => (
              <a class="project-row" href={project.href} target="_blank" rel="noreferrer">
                <span class="project-number">{project.number}</span>
                <div class="project-main">
                  <div class="project-title-line">
                    <h3>{project.title}</h3>
                    <span class:list={['status', project.status]}>{project.statusLabel}</span>
                  </div>
                  <p>{project.description}</p>
                  <ul class="tag-list" aria-label={copy.accessibility.techTags}>
                    {project.tags.map((tag) => <li>{tag}</li>)}
                  </ul>
                </div>
                <div class="project-meta">
                  <span>{project.category}</span>
                  <time>{project.year}</time>
                </div>
                <span class="arrow" aria-hidden="true">↗</span>
                <span class="visually-hidden">{copy.accessibility.newTab}</span>
              </a>
            ))
          }
        </div>
      </section>

      <section id="books" class="section shell" aria-labelledby="books-title">
        <header class="section-heading">
          <div>
            <p class="section-number">02 / BOOKS</p>
            <h2 id="books-title">{copy.books.title}</h2>
          </div>
          <p>{copy.books.intro}</p>
        </header>

        <div class="bookshelf">
          {
            books.map((book, index) => (
              <article class:list={['book-item', index === 0 && 'book-featured']}>
                {index === 0 ? (
                  <div class:list={['book-cover', `tone-${book.tone}`]} aria-hidden="true">
                    <span class="book-code">{book.number}</span>
                    <div>
                      <p>{book.kind}</p>
                      <p class="book-cover-title">{book.title}</p>
                    </div>
                    <span class="book-year">ZIYONE / {book.year}</span>
                  </div>
                ) : (
                  <div class="book-marker" aria-hidden="true">
                    <span class:list={['book-swatch', `tone-${book.tone}`]}></span>
                    <span>{book.number}</span>
                  </div>
                )}
                <div class="book-info">
                  <p class="book-kind">{book.kind} / {book.year}</p>
                  <h3>{book.title}</h3>
                  <p>{book.subtitle}</p>
                  {
                    book.href ? (
                      <a
                        href={book.external === false ? `${base}${book.href}` : book.href}
                        target={book.external === false ? undefined : '_blank'}
                        rel={book.external === false ? undefined : 'noreferrer'}
                      >
                        {book.status} <span aria-hidden="true">{book.external === false ? '→' : '↗'}</span>
                        {book.external !== false && <span class="visually-hidden">{copy.accessibility.newTab}</span>}
                      </a>
                    ) : (
                      <span class="book-status">{book.status}</span>
                    )
                  }
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section id="about" class="about-section" aria-labelledby="about-title">
        <div class="shell about-grid">
          <div class="about-index">
            <p class="section-number">03 / ABOUT</p>
            <h2 id="about-title">{copy.about.title}</h2>
          </div>
          <div class="about-note">
            <p>
              <span>{copy.about.lines[0]}</span>
              <span>{copy.about.lines[1]}</span>
            </p>
            <div class="about-links">
              <a href={profile.github} target="_blank" rel="noreferrer">
                <span>GitHub</span><span aria-hidden="true">↗</span><span class="visually-hidden">{copy.accessibility.newTab}</span>
              </a>
              <a href={`mailto:${profile.email}`}>
                <span>Email</span><span aria-hidden="true">↗</span>
              </a>
              <a href="https://claycosmos.ai" target="_blank" rel="noreferrer">
                <span>ClayCosmos</span><span aria-hidden="true">↗</span><span class="visually-hidden">{copy.accessibility.newTab}</span>
              </a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="shell footer-inner">
        <p>© {currentYear} ZiyOne</p>
        <p>{copy.footer.builtWith}</p>
        <a href="#top">{copy.footer.backToTop}</a>
      </div>
    </footer>

    <script is:inline>
      document.querySelectorAll('[data-locale-link]').forEach((link) => {
        link.addEventListener('click', () => {
          const locale = link.getAttribute('data-locale-link');
          if (locale) {
            try {
              localStorage.setItem('ziyone-locale', locale);
            } catch {
              // Language navigation still works when storage is unavailable.
            }
          }
        });
      });

      (() => {
        const header = document.querySelector('[data-site-header]');
        if (!(header instanceof HTMLElement)) return;

        const initialDelay = 5_000;
        const idleDelay = 2_500;
        let hideTimer;
        let interactionLocked = false;

        const showHeader = () => {
          header.classList.remove('is-hidden');
        };

        const cancelHide = () => {
          window.clearTimeout(hideTimer);
        };

        const scheduleHide = (delay = idleDelay) => {
          cancelHide();
          if (interactionLocked || document.visibilityState === 'hidden') return;
          hideTimer = window.setTimeout(() => {
            if (!interactionLocked) header.classList.add('is-hidden');
          }, delay);
        };

        const revealTemporarily = () => {
          showHeader();
          scheduleHide();
        };

        header.addEventListener('pointerenter', () => {
          interactionLocked = true;
          cancelHide();
          showHeader();
        });

        header.addEventListener('pointerleave', () => {
          interactionLocked = header.contains(document.activeElement);
          scheduleHide();
        });

        header.addEventListener('focusin', () => {
          interactionLocked = true;
          cancelHide();
          showHeader();
        });

        header.addEventListener('focusout', () => {
          window.requestAnimationFrame(() => {
            interactionLocked = header.matches(':hover') || header.contains(document.activeElement);
            scheduleHide();
          });
        });

        window.addEventListener('scroll', revealTemporarily, { passive: true });
        window.addEventListener('wheel', revealTemporarily, { passive: true });
        window.addEventListener('touchmove', revealTemporarily, { passive: true });
        document.addEventListener('visibilitychange', () => {
          if (document.visibilityState === 'visible') revealTemporarily();
          else cancelHide();
        });

        scheduleHide(initialDelay);
      })();
    </script>
  </body>
</html>
