---
import '../styles/ontology.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Ontology 中文学习笔记',
  description = '用最直白的方法学习 Palantir Foundry Ontology：从业务对象、关系和逻辑，到 Action、应用、AI 与企业治理。',
} = Astro.props;

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`${base}books/ontology/og.png`, Astro.site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#153f35" />
    <meta name="description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}favicon.svg`} />
    <title>{title}</title>
  </head>
  <body class="ontology-site">
    <slot />
  </body>
</html>
